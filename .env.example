DATABASE_URL=sqlite:///./warehouse.db
JWT_SECRET=replace-with-a-local-development-secret
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=replace-with-evaluated-model
# Optional: vision model that reads shopping-list photos; leave empty and clients type their list instead
OLLAMA_VISION_MODEL=qwen2.5vl
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
USDA_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
SEED_DEMO_DATA=false
