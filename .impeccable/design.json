  "narrative": {
    "northStar": "The Nutrition Facts Label",
    "overview": "Every screen reads like the label on the back of a grocery package, the one format clients already trust to tell them what is in their food. Facts are ranked by rule weight rather than by boxes and color: a heavy ink rule sits under every page title and product name, a medium rule opens each section, and hairlines separate one fact from the next. The decisive number on a screen (household size, picks in stock, items to restock) is set huge and black like the Calories line.\n\nThe world is a deep ink shell around a cool pale ground. Navigation lives in the ink: a sidebar at laptop width, a top bar on phones, and a bottom tab bar for clients. Content sits on white panels. Product panels are the label itself, with a 2px ink border; everything else floats on soft layered shadows. Epic-Cure blue is rare on purpose: it marks where you are and what to do next, never whether a food is safe.\n\nDensity is calm and touch-first. Clients may be older or have low vision, so targets are at least 44px, body text is 16px, and status always comes as an icon plus plain words. The system refuses the gray SaaS card grid with pastel icon tiles.",
    "keyCharacteristics": [
      "Ink rules at three weights (10px, 5px, 1px) carry the hierarchy.",
      "One family, Archivo, at three weights (400, 700, 900); headings and figures at 900 with tight tracking.",
      "Blue only for current location, selection and the primary action.",
      "Status in three tints (green, yellow, red) always with an icon and words.",
      "Phone-first; the client's scan-to-cart path is the fastest route."
    ],
    "rules": [
      {
        "name": "The Blue Means Go Rule",
        "body": "Blue marks location, selection and the next action. It never signals safety; safety belongs to the three status tints.",
        "section": "colors"
      },
      {
        "name": "The Words-First Status Rule",
        "body": "Every status shows an icon and a plain-language label (\"Good match\", \"Please check\", \"Not recommended\"). Color is the third signal, never the only one.",
        "section": "colors"
      },
      {
        "name": "The Calories Line Rule",
        "body": "Each page gets at most one oversized figure, set at 900 with tabular numbers, beside a short muted unit (\"people in your household\").",
        "section": "typography"
      },
      {
        "name": "The Three Weights Rule",
        "body": "Only 400, 700 and 900. Hierarchy comes from weight and rules, not from extra sizes or colors.",
        "section": "typography"
      },
      {
        "name": "The Lift Means Priority Rule",
        "body": "A heavier shadow means more important, not more interactive. Only the top recipe pick and floating surfaces use the lifted level.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** put a 10px ink rule under every page title and product name, a 5px rule above sections and table headers, and 1px ink hairlines between facts.",
      "**Do** show every safety status as icon plus words, using only the three status tints.",
      "**Do** keep touch targets at 44px minimum; buttons and inputs at 48px.",
      "**Do** use tabular figures for every quantity, count, location and table number.",
      "**Do** keep blue for the current nav item, selection, links, focus and the primary action.",
      "**Do** honor reduced motion; transitions collapse to near zero."
    ],
    "donts": [
      "**Don't** use blue, or any color alone, to say whether a product is safe.",
      "**Don't** build gray SaaS card grids with pastel icon tiles; facts go in labelled rows under ink rules.",
      "**Don't** add uppercase eyebrows or tracked kicker labels above headings.",
      "**Don't** add a fourth font weight, a second typeface, or icon fonts; use the authored stroke icon set.",
      "**Don't** put ink-mist text on white; it is only for text on the ink shell.",
      "**Don't** invent a logo; the brand is the \"Epic-Cure\" wordmark with the \"MTG Warehouse\" descriptor."
    ]
  }
